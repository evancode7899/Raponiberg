# --- App ---
# Put real secrets only in .env (gitignored). This file is safe to commit — leave IDs/secrets empty.
# Copy this file to .env (or run: npm run env:init)
# Path is relative to the prisma/ folder.
DATABASE_URL="file:../data/finance.db"

# Optional: log every SQL statement in dev (very slow). Omit for normal dev.
# PRISMA_LOG_QUERIES="true"

# Optional: if set, protected local endpoints (dashboard, export, transactions,
# shutdown) require header: x-api-secret: <same value>
# Leave empty for normal local single-user use.
# API_SECRET=""

# Optional: if set, database export / import / wipe in Settings require header
# x-settings-database-secret (paste the same value in Settings when calling those actions).
# SETTINGS_DATABASE_SECRET=""

# --- Statements and backups ---
# Folder of statement PDFs the Statements > Import "Scan statements folder" button reads.
# Default: "3. Statements" next to the app folder.
# STATEMENTS_DIR="C:/Users/you/OneDrive/Desktop/Personal Finance/3. Statements"

# Folder of filed tax returns and the forms behind them (W-2s, 1099s, K-1s, 5498-SA), one
# subfolder per year ("2025", "2024"…, nested folders are fine). Read by the same scan
# button and by Statements > Import > "Scan tax documents folder"; the figures go to
# data/tax-documents.json (gitignored). Unset: the Taxes page works from statements only.
# TAX_DOCS_DIR="C:/Users/you/OneDrive/Desktop/Tax"

# Folder OneDrive syncs, where the app backs up the database and data/ files every 15
# minutes while it runs (npm run backup / npm run restore / npm run setup).
# Default: "2. Web App Backup" beside the statements folder, else in
# OneDrive/Desktop/Personal Finance.
# BACKUP_DIR="C:/Users/you/OneDrive/Desktop/Personal Finance/2. Web App Backup"

# --- Demo (npm run demo sets these; leave them out of .env) ---
# APP_PROFILE="demo" marks the demo instance: made-up data, no backups, no real statements folder.
# DATA_DIR is the folder for the JSON stores and stored statements (default: data/).
# APP_PROFILE=""
# DATA_DIR=""
# Port the demo runs on (typing "demo" on the lock screen starts it). Default 3001.
# DEMO_PORT="3001"
